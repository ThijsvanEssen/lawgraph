    <titel status="officieel">Tarief; berekening van de belasting; vrijstellingen </titel>
  </kop><artikel bwb-ng-variabel-deel="/HoofdstukIII/Artikel24" stam-id="3004183" versie-id="31271742" id="C44713271" label-id="2954544" inwerking="2026-01-01" label="Artikel 24" bron="Stcrt.2025-40487" effect="wijziging" ondertekening_bron="2025-12-24" publicatie_bron="2025-12-24" publicatie_iwt="2025-12-24" status="goed">
