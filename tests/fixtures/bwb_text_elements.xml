  <kop>
    <label>Artikel</label>
    <nr status="officieel">1</nr>
    <titel status="officieel">Definities</titel>
  </kop>
  <al>In deze beleidsregel wordt verstaan onder:</al>
  <lijst level="single" nr-sluiting="." start="1" type="ongemarkeerd">
    <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_1">
      <al>
        <nadruk type="cur">CAO SR:</nadruk> CAO Sociale Regeling voor het omroeppersoneel 1 juli 2025 – 30 juni 2030;</al>
    </li>
    <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_2">
      <al>
        <nadruk type="cur">Commissariaat:</nadruk> Commissariaat voor de Media;</al>
    </li>
    <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_3">
      <al>
        <nadruk type="cur">landelijke publieke mediadienst:</nadruk>
      </al>
      <lijst level="single" nr-sluiting="." start="1" type="expliciet">
        <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_3/Onderdeel._1">
          <li.nr>–</li.nr>
          <al>landelijke publieke media-instelling, niet zijnde een samenwerkingsomroep als bedoeld in <extref doc="jci1.3:c:BWBR0025028&amp;artikel=2.24a" label-id="12400254" verwijzing-id="3455600" bwb-id="BWBR0025028">artikel 2.24a van de Mediawet 2008</extref>;</al>
        </li>
        <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_3/Onderdeel._2">
          <li.nr>–</li.nr>
          <al>omroepvereniging die is vertegenwoordigd in een samenwerkingsomroep als bedoeld in <extref doc="jci1.3:c:BWBR0025028&amp;artikel=2.24a" label-id="12400254" verwijzing-id="3455601" bwb-id="BWBR0025028">artikel 2.24a van de Mediawet 2008</extref>; en</al>
        </li>
        <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_3/Onderdeel._3">
          <li.nr>–</li.nr>
          <al>NPO.</al>
        </li>
      </lijst>
    </li>
    <li bwb-ng-variabel-deel="/Artikel1/Onderdeel_4">
      <al>
        <nadruk type="cur">Minister:</nadruk> Minister van Onderwijs Cultuur en Wetenschap.</al>
    </li>
  </lijst>
</artikel>
