          <lid bwb-ng-variabel-deel="/Hoofdstuk8/Artikel138/Lid1" label-id="2942004L1">
            <lidnr status="officieel">1</lidnr>
            <al>Voordat de in tweede lezing aangenomen voorstellen tot verandering in de Grondwet door de Koning worden bekrachtigd, kunnen bij de wet: </al>
            <lijst level="single" nr-sluiting="." start="1" type="expliciet">
              <li bwb-ng-variabel-deel="/Hoofdstuk8/Artikel138/Lid1/Onderdeela">
                <li.nr>a.</li.nr>
                <al>de aangenomen voorstellen en de ongewijzigd gebleven bepalingen van de Grondwet voor zoveel nodig aan elkaar worden aangepast; </al>
                <meta-data>
                  <jcis>
                    <jci versie="1.3" verwijzing="jci1.3:c:BWBR0001840&amp;hoofdstuk=8&amp;artikel=138&amp;lid=1&amp;o=a&amp;z=2023-02-22&amp;g=2023-02-22" onderdeel="o=a" />
                  </jcis>
                </meta-data>
              </li>
              <li bwb-ng-variabel-deel="/Hoofdstuk8/Artikel138/Lid1/Onderdeelb">
                <li.nr>b.</li.nr>
                <al>de indeling in en de plaats van hoofdstukken, paragrafen en artikelen, alsmede de opschriften worden gewijzigd. </al>
                <meta-data>
                  <jcis>
                    <jci versie="1.3" verwijzing="jci1.3:c:BWBR0001840&amp;hoofdstuk=8&amp;artikel=138&amp;lid=1&amp;o=b&amp;z=2023-02-22&amp;g=2023-02-22" onderdeel="o=b" />
                  </jcis>
                </meta-data>
              </li>
            </lijst>
