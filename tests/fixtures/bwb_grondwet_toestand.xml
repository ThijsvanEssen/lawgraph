          <lid bwb-ng-variabel-deel="/Hoofdstuk5/Paragraaf1/Artikel82/Lid1" label-id="2941394L1">
            <lidnr status="officieel">1</lidnr>
            <al>Voorstellen van wet kunnen worden ingediend door of vanwege de Koning en door de Tweede Kamer der Staten-Generaal. </al>
            <meta-data>
              <jcis>
                <jci versie="1.3" verwijzing="jci1.3:c:BWBR0001840&amp;hoofdstuk=5&amp;paragraaf=1&amp;artikel=82&amp;lid=1&amp;z=2023-02-22&amp;g=2023-02-22" onderdeel="lid=1" />
