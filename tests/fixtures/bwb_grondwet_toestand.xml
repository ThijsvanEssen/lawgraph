        <artikel bwb-ng-variabel-deel="/Hoofdstuk1/Artikel7" stam-id="2990103" versie-id="25689252" id="C36647081" label-id="2940564" inwerking="2018-12-21" label="Artikel 7" bron="Stb.2019-33" effect="tekstplaatsing-wijziging" ondertekening_bron="2019-01-16" publicatie_bron="2019-02-08" publicatie_iwt="2018-12-21" status="goed">
