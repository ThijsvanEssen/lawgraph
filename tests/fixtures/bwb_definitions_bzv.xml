<toestand bwb-id="BWBR0018492"><wetgeving><wettekst><artikel bwb-ng-variabel-deel="/Hoofdstuk1/Artikel1" stam-id="7187443" versie-id="30322972" id="C43497341" label-id="7175214" inwerking="2024-09-14" label="Artikel 1" bron="Stb.2024-256" effect="wijziging" ondertekening_bron="2024-09-09" publicatie_bron="2024-09-13" publicatie_iwt="2024-09-13" status="goed">
