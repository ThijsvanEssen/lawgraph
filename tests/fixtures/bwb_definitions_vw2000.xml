<toestand bwb-id="BWBR0011823"><wetgeving><wettekst><artikel bwb-ng-variabel-deel="/Hoofdstuk1/Afdeling1/Artikel1" stam-id="1426303" versie-id="31609892" id="C45155931" label-id="1384094" inwerking="2026-06-12" label="Artikel 1" bron="Stb.2026-127" effect="wijziging" ondertekening_bron="2026-05-27" publicatie_bron="2026-06-10" publicatie_iwt="2026-06-10" status="goed">
