{
  "about": "The pages the explorer asks first, by their size and order: lawgraph-explorer owns this file (src/lib/api/first-pages.json), and the API warms up exactly these pages from this copy (api/warm.py). A change goes into both repositories at once.",
  "article_citations": [
    {"sort": "date_desc", "limit": 200},
    {"sort": "citation_count", "limit": 200},
    {"sort": "citation_count", "limit": 6}
  ],
  "article_neighborhood": {
    "depth": 2,
    "cap": 150,
    "node_types": ["instrument", "article", "annex", "judgment", "dossier", "document", "activity", "decision", "commitment", "member", "faction", "committee", "cabinet", "ministry"],
    "props": "canvas",
    "stop_at": ["members", "factions", "committees", "cabinets", "ministries"]
  },
  "law_judgments": 100,
  "instrument_names": {"sort": "article_count", "limit": 200},
  "lists": {
    "instruments": 100,
    "documents": 100,
    "judgments": 100,
    "feed": 100
  },
  "home_summary": {"days": 14, "limit": 30}
}
