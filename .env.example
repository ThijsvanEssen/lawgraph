# ── ArangoDB connection ───────────────────────────────────────────────────────
ARANGO_URL=http://localhost:8529
ARANGO_DB_NAME=lawgraph
ARANGO_USER=root
ARANGO_PASSWORD=changeme

# ── Collection names (optional overrides) ─────────────────────────────────────
# LAWGRAPH_DOCUMENT_COLLECTIONS=instruments,instrument_articles,...  # comma-separated
# LAWGRAPH_EDGE_COLLECTION=edges

# ── External API base URLs ────────────────────────────────────────────────────
TK_API_BASE=https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/
RECHTSPRAAK_BASE=https://data.rechtspraak.nl/
EURLEX_BASE=https://eur-lex.europa.eu/
BWB_BASE=https://wetten.overheid.nl/
BWB_SRU_ENDPOINT=https://zoekservice.overheid.nl/sru/Search
EURLEX_SPARQL_ENDPOINT=https://publications.europa.eu/webapi/rdf/sparql
STAATSBLAD_SRU_ENDPOINT=https://sru.officielebekendmakingen.nl/sru/Search
STAATSBLAD_REPO_BASE=https://repository.overheid.nl
STAATSCOURANT_SRU_ENDPOINT=https://sru.officielebekendmakingen.nl/sru/Search
EERSTEKAMER_BASE=https://gegevensmagazijn.eerstekamer.nl/OData/v4/2.0/
ECHR_HUDOC_BASE=https://hudoc.echr.coe.int
VERDRAGENBANK_SPARQL=https://linkeddata.overheid.nl/front/portal/sparql

# ── Domain profile ────────────────────────────────────────────────────────────
# LAWGRAPH_PROFILE=strafrecht

# ── API server ────────────────────────────────────────────────────────────────
# LAWGRAPH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# LAWGRAPH_API_HOST=0.0.0.0
# LAWGRAPH_API_PORT=8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# LAWGRAPH_RATE_LIMIT_CALLS=200    # max requests per window per IP
# LAWGRAPH_RATE_LIMIT_PERIOD=60    # window size in seconds
# LAWGRAPH_TRUSTED_PROXIES=        # comma-separated IPs allowed to set X-Forwarded-For

# ── In-process cache ─────────────────────────────────────────────────────────
# LAWGRAPH_CACHE_TTL=60            # seconds
# LAWGRAPH_CACHE_MAXSIZE=512       # max cached entries

# ── Semantic confidence overrides ─────────────────────────────────────────────
# LAWGRAPH_CONFIDENCE_<PATTERN_NAME_UPPER>=0.95
# Example: LAWGRAPH_CONFIDENCE_BWB_EXPLICIT=0.95

# ── Logging ───────────────────────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=INFO
# LAWGRAPH_LOG_FORMAT=json         # set to "json" for structured output
# NO_COLOR=1                       # disable ANSI colors in log output
