# Copy to .env. Every variable is optional except the passwords; the values shown for the
# optional ones are the defaults. A flag takes true/false (or 1/0, yes/no, on/off); a value a
# setting cannot read stops the start, naming the variable. All variables are described in
# docs/operations.md.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
LAWGRAPH_DB_PASSWORD=changeme      # read by docker-compose.yml and by the default URL below
# LAWGRAPH_DB_URL=postgresql://lawgraph:<LAWGRAPH_DB_PASSWORD>@localhost:5432
# LAWGRAPH_DB_NAME=lawgraph          # created on first use when it does not exist
# LAWGRAPH_DB_POOL_SIZE=8            # connections per process
# LAWGRAPH_DB_BACKGROUND_POOL_SIZE=4 # connections per API process for its background computations
# LAWGRAPH_ALLOW_COLLATION=          # a collation let through anyway, for a dump and restore
# LAWGRAPH_WRITE_TIMEOUT_MS=600000   # the longest a writing statement may run; a build sets more
# LAWGRAPH_READ_TIMEOUT_MS=10800000  # the longest one reading statement may run
# LAWGRAPH_WATCHDOG_MINUTES=10      # how often a running step says what it is doing
# LAWGRAPH_API_REQUEST_TIMEOUT_MS=30000  # the API: the longest one request may read the database
# LAWGRAPH_API_WARM_UP=true           # the API computes the common answers at its start and after a data change
# LAWGRAPH_WARM_UP_MIN_INTERVAL=0      # minutes between the starts of two warm-ups at the least (0: none)
# LAWGRAPH_LAW_CITATIONS_ROWS=2000000   # the API: rows (law, judgment) kept in memory of the judgments citing a law, ~130 bytes each
# LAWGRAPH_DB_SIZE_ALERT_GIB=70          # `lawgraph check` fails from this size on
# The server of docker-compose.yml, sized for 8 GB; raise for a build on a larger machine
# (16 GB: 8g, 4GB, 6GB, 64MB, 1GB):
# LAWGRAPH_PG_MEMORY=4g                  # mem_limit of the container
# LAWGRAPH_PG_SHARED_BUFFERS=1GB
# LAWGRAPH_PG_CACHE=3GB                  # effective_cache_size: the rest of the memory
# LAWGRAPH_PG_WORK_MEM=32MB
# LAWGRAPH_PG_MAINTENANCE_WORK_MEM=512MB

# ── Payload store (the XML and HTML of raw records) ───────────────────────────
# LAWGRAPH_PAYLOAD_STORE=file://~/.local/share/lawgraph/payloads   # or s3://bucket[/prefix]
# LAWGRAPH_S3_ENDPOINT=https://leafcloud.store
# LAWGRAPH_S3_REGION=europe-nl-ams1
# LAWGRAPH_S3_ACCESS_KEY=
# LAWGRAPH_S3_SECRET_KEY=

# ── Pipelines ─────────────────────────────────────────────────────────────────
# LAWGRAPH_BWB_IDS=BWBR0001854,BWBR0001903 # regulations for incremental `retrieve bwb`
# LAWGRAPH_CONFIDENCE_SCOPE_LIMITATION=0.8 # LAWGRAPH_CONFIDENCE_<PATTERN>
# LAWGRAPH_RETRIEVE_SKIP_ECHR=true         # LAWGRAPH_<PHASE>_SKIP_<SOURCE>
# LAWGRAPH_SOURCES_OFF=echr                # sources no scheduled run asks anything
# LAWGRAPH_EK_ATTRIBUTION=Eerste Kamer der Staten-Generaal, www.eerstekamer.nl

# ── API ───────────────────────────────────────────────────────────────────────
# LAWGRAPH_API_HOST=127.0.0.1
# LAWGRAPH_API_PORT=8000
# LAWGRAPH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# LAWGRAPH_RATE_LIMIT_CALLS=200
# LAWGRAPH_RATE_LIMIT_PERIOD=60
# LAWGRAPH_TRUSTED_PROXIES=
# LAWGRAPH_SITEMAP_DIR=~/.local/share/lawgraph/sitemaps   # where `lawgraph sitemaps` writes
# LAWGRAPH_SPA_INDEX=/srv/lawgraph/concordans/current/index.html   # the shell /render fills
# LAWGRAPH_SEARCH_STATS_DIR=~/.local/share/lawgraph/search-stats   # counts of the terms searched, per day
# LAWGRAPH_SITE_URL=http://localhost:5173   # Concordans, where the Atom feed links to

# ── Logging ───────────────────────────────────────────────────────────────────
# LAWGRAPH_LOG_LEVEL=INFO
# LAWGRAPH_LOG_FORMAT=text              # or json: one JSON object per line
# LAWGRAPH_LOG_FILE=lawgraph.log
# LAWGRAPH_OUTCOME_FILE=outcome.txt    # why the command ended so, in one line (the scheduled scripts set it)
# NO_COLOR=1
