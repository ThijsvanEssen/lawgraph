# /srv/lawgraph/scheduler.env: the environment of the scheduled runs (EnvironmentFile= of the lawgraph-* units)
# and of the ops scripts. Names only; the server has the values.
LAWGRAPH_LOG_DIR=/srv/lawgraph/logs
TMPDIR=/srv/lawgraph/tmp
LAWGRAPH_ALERT_COMMAND=/srv/lawgraph/bin/alert.sh
# where daily.sh's `lawgraph sitemaps` writes; Caddy serves it at /sitemap* (caddy/concordans.caddy)
LAWGRAPH_SITEMAP_DIR=/srv/lawgraph/concordans/sitemaps
