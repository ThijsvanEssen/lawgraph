[Unit]
Description=LawGraph: poll tk, window %i
After=docker.service
RequiresMountsFor=/srv/lawgraph

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/lawgraph/app
EnvironmentFile=/srv/lawgraph/scheduler.env
SuccessExitStatus=75
TimeoutStartSec=45min
ExecStart=/srv/lawgraph/app/scripts/poll.sh tk %i
