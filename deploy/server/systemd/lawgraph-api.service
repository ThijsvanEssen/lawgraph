[Unit]
Description=LawGraph API
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/srv/lawgraph

[Service]
User=ubuntu
WorkingDirectory=/srv/lawgraph/app
ExecStart=/srv/lawgraph/app/.venv/bin/lawgraph-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lawgraph
PrivateTmp=true

[Install]
WantedBy=multi-user.target
